{
  "version": 8,
  "name": "AgroLink Ethiopia",
  "metadata": {
    "mapbox:autocomposite": false,
    "mapbox:type": "template"
  },
  "sources": {
    "composite": {
      "url": "mapbox://mapbox.mapbox-streets-v8,mapbox.mapbox-terrain-v2",
      "type": "vector"
    }
  },
  "sprite": "mapbox://sprites/mapbox/streets-v11",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#F5F5F5" }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          ["park", "grass", "scrub", "wood"],
          "#DCE8D5",
          ["agriculture", "farmland"],
          "#EAF3D9",
          "#F0EDE5"
        ],
        "fill-opacity": 0.7
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": { "fill-color": "#A9C8E8" }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          5, 0.5,
          10, 1.5,
          15, 4
        ]
      }
    },
    {
      "id": "road-borders",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "paint": {
        "line-color": "#D8D8D8",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          5, 1,
          10, 2.5,
          15, 5
        ],
        "line-gap-width": 2
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          5, 10,
          10, 14,
          15, 16
        ]
      },
      "paint": {
        "text-color": "#1B1B1B",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
      }
    }
  ]
}