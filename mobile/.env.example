# =============================================================
# AGROLINK ETHIOPIA — MOBILE APP ENVIRONMENT VARIABLES
# Copy to .env.development or .env.production and fill in real values.
# NEVER commit real secrets. Only .env.example is committed.
# =============================================================

# --- App variant ---
APP_VARIANT=development
EXPO_OFFLINE=1

# --- API ---
API_URL=http://localhost:5000/api/v1
SOCKET_URL=http://localhost:5000

# --- Third-party services ---
GOOGLE_MAPS_API_KEY=
AGORA_APP_ID=
SENTRY_DSN=

# --- Features ---
ENABLE_DEBUG=true
ENABLE_BIOMETRIC_LOGIN=true
ENABLE_PUSH_NOTIFICATIONS=true

# --- EAS ---
EAS_PROJECT_ID=