{
  "name": "agrolink-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --offline --host lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --offline --host lan",
    "prebuild": "expo prebuild --clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "detox test --configuration android.emu.debug",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "assets:verify": "node scripts/verify-assets.js",
    "eas:build:dev": "eas build --profile development --platform all",
    "eas:build:preview": "eas build --profile preview --platform android",
    "eas:build:prod": "eas build --profile production --platform all",
    "eas:submit:ios": "eas submit --platform ios",
    "eas:submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.3.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/drawer": "^6.6.15",
    "@react-navigation/material-top-tabs": "^6.6.13",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@tanstack/react-query": "^5.51.23",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "expo": "~51.0.28",
    "expo-asset": "~10.0.10",
    "expo-av": "~14.0.7",
    "expo-build-properties": "^0.12.5",
    "expo-camera": "~15.0.16",
    "expo-constants": "~16.0.2",
    "expo-device": "~6.0.2",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-image-manipulator": "~12.0.5",
    "expo-image-picker": "~15.1.0",
    "expo-linking": "~6.3.1",
    "expo-local-authentication": "~14.0.1",
    "expo-localization": "~15.0.3",
    "expo-location": "~17.0.1",
    "expo-notifications": "~0.28.18",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "expo-task-manager": "~11.8.2",
    "i18next": "^23.12.2",
    "lottie-react-native": "6.7.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^14.1.2",
    "react-native": "0.74.5",
    "react-native-calendars": "^1.1306.0",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-maps": "1.14.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-signature-canvas": "^4.7.2",
    "react-native-svg": "15.2.0",
    "react-native-vector-icons": "^10.1.0",
    "react-native-web": "~0.19.10",
    "react-native-webview": "13.8.6",
    "socket.io-client": "^4.7.5",
    "victory-native": "^41.16.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
