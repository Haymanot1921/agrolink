# =============================================================
# AGROLINK ETHIOPIA — WEB (React + Vite) ENVIRONMENT TEMPLATE
# =============================================================
# Copy this file to .env.local and fill in real values.
# ⚠️ NEVER commit .env.local to git.
# ⚠️ VITE_ prefix is REQUIRED for any variable exposed to the browser.
# ⚠️ Do NOT put secrets (API keys, service tokens) here — anything
#    prefixed with VITE_ is bundled into the final JavaScript build.

# ─────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────
# Base URL for the Express backend (SRS §3.3, §12.1)
VITE_API_URL=http://localhost:5000/api/v1

# Socket.IO endpoint (SRS §5.11, §5.12)
VITE_SOCKET_URL=http://localhost:5000

# ─────────────────────────────────────────────────────────────
# Branding
# ─────────────────────────────────────────────────────────────
VITE_APP_NAME=AgroLink Ethiopia
VITE_APP_TAGLINE=Connecting farmers, buyers, and experts
VITE_APP_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Feature flags (see src/shared/constants/platform.ts)
# ─────────────────────────────────────────────────────────────
VITE_ENABLE_AMHARIC=true
VITE_ENABLE_VIDEO_CONSULTATIONS=true
VITE_ENABLE_VOICE_MESSAGES=true
VITE_ENABLE_PAYMENTS_RECORD_ONLY=true
VITE_ENABLE_LIVE_PAYMENT_GATEWAY=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CRASH_REPORTING=false

# ─────────────────────────────────────────────────────────────
# Maps (display-only per SRS §13.4 — NO delivery tracking)
# ─────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────
# Uploads (SRS §13.3 — metadata + storage refs only)
# ─────────────────────────────────────────────────────────────
VITE_MAX_IMAGE_SIZE_MB=5
VITE_MAX_DOCUMENT_SIZE_MB=10

# ─────────────────────────────────────────────────────────────
# Payments — record-only in release 1 (SRS §13.1)
# ─────────────────────────────────────────────────────────────
VITE_PAYMENT_MODE=record_only

# ─────────────────────────────────────────────────────────────
# Development
# ─────────────────────────────────────────────────────────────
VITE_ENABLE_DEBUG=false
VITE_LOG_LEVEL=info