# ─────────────────────────────────────────────────────────────────────────────
# AgroLink Ethiopia — Backend Environment Configuration
# Copy to `.env` and fill in values. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=AgroLink Ethiopia
APP_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,am
TZ=Africa/Addis_Ababa
CURRENCY=ETB

# ─── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/agrolink
MONGODB_DB_NAME=agrolink
MONGODB_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT=10000

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_32_MIN_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_32_MIN_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=agrolink-ethiopia
JWT_AUDIENCE=agrolink-clients
MFA_STEP_UP_SECRET=CHANGE_ME_MFA_SECRET
MFA_MAX_AGE_SECONDS=300

# ─── Password policy ────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TTL_MIN=30
EMAIL_VERIFY_TTL_MIN=60
OTP_TTL_SECONDS=300
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept-Language,X-Request-Id,X-MFA-Token

# ─── Rate limiting (falls back to memory when REDIS_URL is empty) ──────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
REDIS_URL=
RATELIMIT_IN_TEST=false

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_ENABLE_FILE=false
LOG_REDACT_KEYS=password,passwordHash,token,accessToken,refreshToken,authorization,otp

# ─── Uploads / Cloudinary ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=agrolink
CLOUDINARY_MAX_UPLOAD_MB=10
CLOUDINARY_IMAGE_TYPES=jpg,jpeg,png,webp
CLOUDINARY_DOC_TYPES=pdf,jpg,jpeg,png
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf

# ─── Socket.IO ──────────────────────────────────────────────────────────────
SOCKET_ENABLED=true
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000
SOCKET_PING_TIMEOUT=25000
SOCKET_PING_INTERVAL=20000
SOCKET_MAX_BUFFER=1000000
SOCKET_TRANSPORTS=websocket,polling

# ─── Email (choose one provider) ────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=AgroLink Ethiopia
EMAIL_FROM_ADDRESS=no-reply@agrolink.et
EMAIL_REPLY_TO=support@agrolink.et
# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SendGrid
SENDGRID_API_KEY=
# AWS SES
AWS_SES_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── SMS (choose one provider) ──────────────────────────────────────────────
SMS_PROVIDER=africastalking
SMS_SENDER_ID=AgroLink
# Africa's Talking
AT_USERNAME=sandbox
AT_API_KEY=
AT_BASE_URL=https://api.africastalking.com/version1/messaging
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Payments (SRS §13.1 — record-only in first release) ───────────────────
PAYMENT_RECORD_ONLY=true
PAYMENT_PROVIDERS=telebirr,cbe_birr,cash_on_record
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_BASE_URL=https://telebirr.et/api
CBE_BIRR_MERCHANT_ID=
CBE_BIRR_API_KEY=
CBE_BIRR_BASE_URL=

# ─── Video (consultations) ──────────────────────────────────────────────────
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_APP_SECRET=
DAILY_API_KEY=
DAILY_BASE_URL=https://api.daily.co/v1
VIDEO_MAX_SESSION_MINUTES=60

# ─── Maps (nearby marketplace search) ──────────────────────────────────────
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
MAPS_DEFAULT_COUNTRY=ET
MAPS_DEFAULT_LAT=9.0300
MAPS_DEFAULT_LNG=38.7400

# ─── Reports ────────────────────────────────────────────────────────────────
REPORT_EXPORT_DIR=./tmp/reports
REPORT_FORMATS=csv,xlsx,pdf
REPORT_MAX_RANGE_DAYS=366

# ─── Assisted monitoring (SRS §6.8, deterministic heuristics) ─────────────
ASSISTED_DUPLICATE_WINDOW_MIN=30
ASSISTED_MAX_ACTIONS_PER_HOUR=20
ASSISTED_MAX_CONSENT_AGE_DAYS=365

# ─── Seed (optional one-off) ────────────────────────────────────────────────
SEED_SUPERADMIN_EMAIL=superadmin@agrolink.et
SEED_SUPERADMIN_PASSWORD=ChangeMe#2026
SEED_SUPERADMIN_PHONE=+251900000000